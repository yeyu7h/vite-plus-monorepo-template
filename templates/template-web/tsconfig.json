{
  "extends": "@monorepo/tsconfig/vue.json",
  "compilerOptions": {
    "types": ["vite-plus/client"],
    "paths": {
      "@/*": ["./src/*"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "files": [],
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "typed-router.d.ts", "components.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
