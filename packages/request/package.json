{
  "name": "@monorepo/request",
  "version": "0.0.0",
  "description": "Axios request client with interceptors, token refresh, upload, and download helpers.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "production": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "axios": "catalog:",
    "defu": "catalog:utils",
    "qs": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devDependencies": {
    "@types/qs": "catalog:testing"
  }
}
