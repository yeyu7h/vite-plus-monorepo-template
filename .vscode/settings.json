{
  "npm.scriptRunner": "vp",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "$(capture).test.ts, $(capture).test.tsx, $(capture).spec.ts, $(capture).spec.tsx, $(capture).d.ts",
    "tsconfig.json": "tsconfig.*.json",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .oxfmt*, .prettier*, prettier*, .editorconfig"
  },
  "cSpell.words": [
    "asteasolutions",
    "bullmq",
    "bumpp",
    "casbin",
    "clsx",
    "crios",
    "cros",
    "dedupe",
    "defu",
    "demi",
    "dotenvx",
    "edga",
    "edgios",
    "esbuild",
    "excelize",
    "fxios",
    "hono",
    "ioredis",
    "lucide",
    "nuxt",
    "oxfmt",
    "oxlint",
    "pino",
    "ptype",
    "tsgo",
    "vite",
    "vitejs",
    "vitest",
    "wxjs"
  ],
  "oxc.fmt.configPath": "./vite.config.ts",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.classAttributes": ["class"],
  "tailwindCSS.classFunctions": ["cn", "clsx"],
  "tailwindCSS.experimental.classRegex": [
    ["(?:v-bind:|:)ui=\"([^\"]*)\"", "(?:^|[,{])\\s*(?:[\\w$-]+|['\"][^'\"]+['\"])\\s*:\\s*['\"`]([^'\"`]*)['\"`]"],
    ["(?:^|[,{])\\s*(?:[A-Za-z_$][\\w$]*Class|['\"][A-Za-z_$][\\w$]*Class['\"])\\s*:\\s*['\"`]([^'\"`]*)['\"`]"]
  ]
}
