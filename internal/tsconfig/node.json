{
  "extends": "./base.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true
  }
}
