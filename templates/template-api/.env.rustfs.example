# Copy to .env.rustfs; fill credentials before use. This file is never loaded automatically.
PORT=9999
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres"
REDIS_URL="redis://redis:6379/0"
CLIENT_JWT_SECRET=
ADMIN_JWT_SECRET=
MINIAPP_APPS='{}'

STORAGE_PROVIDER=rustfs
# Host development: localhost; the RustFS Compose overlay sets the API's internal address automatically.
ENDPOINT="http://localhost:9000"
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME="app-files"
STORAGE_REGION=
STORAGE_FORCE_PATH_STYLE=
# Production: use your externally reachable HTTPS S3 endpoint.
STORAGE_PRESIGN_ENDPOINT="http://localhost:9000"
STORAGE_PUBLIC_BASE_URL=
STORAGE_CORS_ALLOWED_ORIGINS="http://localhost:5173"
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
SENTRY_DSN=
