# Copy to .env.rustfs and fill credentials before use; this file is never loaded automatically / 复制为 .env.rustfs 并在使用前填写凭据；此文件不会自动加载
PORT=9999
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres"
REDIS_URL="redis://redis:6379/0"
ADMIN_JWT_SECRET=
CLIENT_JWT_SECRET=
MINIAPP_APPS='{}'
USER_UID_PREFIX=1
CLIENT_ACCESS_TOKEN_SECONDS=900
CLIENT_SESSION_SECONDS=604800

STORAGE_PROVIDER=rustfs
# Host development: localhost; the RustFS Compose overlay sets the API's internal address automatically / 宿主机开发使用 localhost；RustFS Compose 覆盖配置会自动设置 API 的内部地址
ENDPOINT="http://localhost:9000"
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME="app-files"
STORAGE_REGION=
STORAGE_FORCE_PATH_STYLE=
# Production: use your externally reachable HTTPS S3 endpoint / 生产环境使用外部可访问的 HTTPS S3 端点
STORAGE_PRESIGN_ENDPOINT="http://localhost:9000"
STORAGE_PUBLIC_BASE_URL=
STORAGE_CORS_ALLOWED_ORIGINS="http://localhost:5173"
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
SENTRY_DSN=
